import java.util.HashSet;
public class RemoveDuplicates {
 public static void main(String[] args) {
 int[] arr = {1, 2, 2, 3, 4, 4};
 HashSet<Integer> set = new HashSet<>();
 for (int num : arr) {
 set.add(num);
 }
 System.out.println(set);
 }
}


[4, 1, 2, 3]
- HashSet does not maintain insertion order.

