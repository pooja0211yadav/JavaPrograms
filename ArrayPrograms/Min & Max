public class MaxMinArray {
    public static void main(String[] args) {

        int[] arr = {10, 5, 20, 8, 2, 15};

        if (arr.length == 0) {
            System.out.println("Array is empty");
            return;
        }

        int max = arr[0];
        int min = arr[0];

        for (int num : arr) {
            if (num > max) {
                max = num;
            }

            if (num < min) {
                min = num;
            }
        }

        System.out.println("Max = " + max);
        System.out.println("Min = " + min);
    }
}
